{
  "name": "api-diff-viewer",
  "version": "1.2.0",
  "description": "CodeMirror-based component to view the difference between two API documents: OpenAPI, AsyncAPI, GraphApi (GraphQL), ProtoApi (gRPC), JSON Schema",
  "author": "Damir Yusipov",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "module": "dist/api-diff-viewer.es.js",
  "main": "dist/api-diff-viewer.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/api-diff-viewer.es.js",
      "require": "./dist/api-diff-viewer.umd.js"
    },
    "./style.css": "./dist/api-diff-viewer.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vp pack",
    "dev": "vitepress dev docs",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage --project unit",
    "test-storybook": "vp test run --project storybook",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:storybook": "storybook build --disable-telemetry --quiet -o docs/.vitepress/dist/storybook",
    "docs:preview": "vitepress preview docs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/udamir/api-diff-viewer"
  },
  "keywords": [
    "codemirror",
    "jsonschema",
    "diff",
    "compare",
    "side-by-side",
    "openapi",
    "asyncapi",
    "graphql",
    "graphapi",
    "grpc",
    "protoapi",
    "api"
  ],
  "dependencies": {
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.1",
    "@lezer/highlight": "^1.2.5",
    "api-smart-diff": "^2.0.1",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@codemirror/search": "^6.7.3",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/addon-links": "^10.6.9",
    "@storybook/addon-vitest": "^10.6.9",
    "@storybook/html-vite": "^10.6.9",
    "@types/node": "^26.6.11",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "js-yaml": "^5.5.0",
    "playwright": "^1.65.1",
    "storybook": "^10.6.9",
    "typescript": "^7.0.2",
    "vite-plus": "^1.8.0",
    "vitepress": "2.0.0-alpha.21",
    "vitest": "5.1.1",
    "vue": "^3.5.46"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0"
}
