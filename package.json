{
  "name": "api-diff-viewer",
  "version": "2.0.0",
  "description": "CodeMirror-based component to view the difference between two API documents: OpenAPI, AsyncAPI, GraphApi (GraphQL), ProtoApi (gRPC), JSON Schema",
  "author": "Damir Yusipov",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "module": "dist/api-diff-viewer.es.js",
  "main": "dist/api-diff-viewer.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/api-diff-viewer.es.js",
      "require": "./dist/api-diff-viewer.umd.js"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest --project=storybook",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "demo": "vite demo/",
    "build-demo": "vite build --config demo/vite.config.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/udamir/api-diff-viewer"
  },
  "keywords": [
    "codemirror",
    "jsonschema",
    "diff",
    "compare",
    "side-by-side",
    "openapi",
    "asyncapi",
    "graphql",
    "graphapi",
    "grpc",
    "protoapi",
    "api"
  ],
  "dependencies": {
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.1",
    "@lezer/highlight": "^1.2.5",
    "api-smart-diff": "^2.0.1",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@codemirror/search": "^6.7.3",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/addon-links": "^10.6.9",
    "@storybook/addon-vitest": "^10.6.9",
    "@storybook/html-vite": "^10.6.9",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "js-yaml": "^5.5.0",
    "playwright": "^1.65.1",
    "storybook": "^10.6.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0"
}
